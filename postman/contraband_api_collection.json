{"info":{"description":"Postman-tested API collection for the Restricted Zone Contraband Detection backend (FastAPI). Import into Postman via Import > File. Set base_url to your backend (default http://localhost:8000). Login first; the token is saved to the collection variable automatically by the login request's test script.","name":"Contraband Detection API","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"item":[{"event":[{"listen":"test","script":{"exec":["pm.test('login ok', () => pm.response.to.have.status(200));","const j = pm.response.json();","pm.collectionVariables.set('token', j.access_token);"],"type":"text/javascript"}}],"name":"Login (admin)","request":{"body":{"mode":"urlencoded","urlencoded":[{"key":"username","value":"admin"},{"key":"password","value":"admin123"}]},"header":[{"key":"Content-Type","value":"application/x-www-form-urlencoded"}],"method":"POST","url":"{{base_url}}/api/auth/login"}},{"name":"Me","request":{"auth":{"bearer":[{"key":"token","type":"string","value":"{{token}}"}],"type":"bearer"},"method":"GET","url":"{{base_url}}/api/auth/me"}},{"name":"Register officer (admin only)","request":{"auth":{"bearer":[{"key":"token","type":"string","value":"{{token}}"}],"type":"bearer"},"body":{"mode":"raw","options":{"raw":{"language":"json"}},"raw":"{\"username\": \"officer1\", \"password\": \"officer123\", \"role\": \"officer\"}"},"header":[{"key":"Content-Type","value":"application/json"}],"method":"POST","url":"{{base_url}}/api/auth/register"}}],"name":"Auth (FR1)"},{"item":[{"name":"List zones","request":{"auth":{"bearer":[{"key":"token","type":"string","value":"{{token}}"}],"type":"bearer"},"method":"GET","url":"{{base_url}}/api/zones"}},{"name":"Add zone (admin)","request":{"auth":{"bearer":[{"key":"token","type":"string","value":"{{token}}"}],"type":"bearer"},"body":{"mode":"raw","options":{"raw":{"language":"json"}},"raw":"{\"name\": \"Server Room\", \"description\": \"No phones, no smoking\"}"},"header":[{"key":"Content-Type","value":"application/json"}],"method":"POST","url":"{{base_url}}/api/zones"}},{"name":"Update zone (admin)","request":{"auth":{"bearer":[{"key":"token","type":"string","value":"{{token}}"}],"type":"bearer"},"body":{"mode":"raw","options":{"raw":{"language":"json"}},"raw":"{\"name\": \"Server Room A\", \"description\": \"Updated\"}"},"header":[{"key":"Content-Type","value":"application/json"}],"method":"PUT","url":"{{base_url}}/api/zones/1"}},{"name":"Remove zone (admin)","request":{"auth":{"bearer":[{"key":"token","type":"string","value":"{{token}}"}],"type":"bearer"},"method":"DELETE","url":"{{base_url}}/api/zones/1"}}],"name":"Zones (FR2)"},{"item":[{"name":"Get threshold","request":{"auth":{"bearer":[{"key":"token","type":"string","value":"{{token}}"}],"type":"bearer"},"method":"GET","url":"{{base_url}}/api/settings/threshold"}},{"name":"Set threshold","request":{"auth":{"bearer":[{"key":"token","type":"string","value":"{{token}}"}],"type":"bearer"},"body":{"mode":"raw","options":{"raw":{"language":"json"}},"raw":"{\"threshold\": 0.55}"},"header":[{"key":"Content-Type","value":"application/json"}],"method":"POST","url":"{{base_url}}/api/settings/threshold"}}],"name":"Threshold (FR3)"},{"item":[{"name":"Upload video","request":{"auth":{"bearer":[{"key":"token","type":"string","value":"{{token}}"}],"type":"bearer"},"body":{"formdata":[{"key":"file","type":"file"},{"key":"camera_location","type":"text","value":"Server Room"}],"mode":"formdata"},"method":"POST","url":"{{base_url}}/api/videos/upload"}},{"name":"Run detection (FR5)","request":{"auth":{"bearer":[{"key":"token","type":"string","value":"{{token}}"}],"type":"bearer"},"body":{"mode":"raw","options":{"raw":{"language":"json"}},"raw":"{\"video_id\": \"PASTE_VIDEO_ID\", \"zone_id\": 1, \"frame_skip\": 5}"},"header":[{"key":"Content-Type","value":"application/json"}],"method":"POST","url":"{{base_url}}/api/detect/run"}}],"name":"Video + Detection (FR4/FR5)"},{"item":[{"name":"List incidents (filtered)","request":{"auth":{"bearer":[{"key":"token","type":"string","value":"{{token}}"}],"type":"bearer"},"method":"GET","url":"{{base_url}}/api/incidents?violation_type=smoking&zone_id=1"}},{"name":"Analytics summary","request":{"auth":{"bearer":[{"key":"token","type":"string","value":"{{token}}"}],"type":"bearer"},"method":"GET","url":"{{base_url}}/api/analytics/summary"}},{"name":"Download PDF report","request":{"auth":{"bearer":[{"key":"token","type":"string","value":"{{token}}"}],"type":"bearer"},"method":"GET","url":"{{base_url}}/api/reports/pdf"}},{"name":"Health check","request":{"method":"GET","url":"{{base_url}}/api/health"}}],"name":"Incidents / Analytics / Reports (FR9/FR10/FR11)"}],"variable":[{"key":"base_url","value":"http://localhost:8000"},{"key":"token","value":""}]}
# Copy to .env and adjust. Never commit a real .env with secrets.

# Database: SQLite for local dev, MySQL for production (per proposal)
DATABASE_URL=sqlite:///./fyp.db
# DATABASE_URL=mysql+pymysql://fyp_user:fyppass123@localhost:3306/fyp_contraband

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MIN=480

# AI model
MODEL_PATH=ai/runs/best.pt
DEFAULT_CONF_THRESHOLD=0.45

# Storage dirs
UPLOAD_DIR=backend/uploads
EVIDENCE_DIR=evidence
REPORTS_DIR=reports
